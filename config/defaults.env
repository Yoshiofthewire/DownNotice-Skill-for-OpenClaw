# Default polling interval in seconds (15 minutes)
POLL_INTERVAL_SECONDS=900

# Feed sources
FEEDS=(
  "https://azure.status.microsoft/en-us/status/feed/"
  "https://status.aws.amazon.com/rss/all.rss"
  "https://status.cloud.google.com/en/feed.atom"
  "https://www.githubstatus.com/history.rss"
  "https://www.cloudflarestatus.com/history.atom"
)

# Include only these canonical statuses in notifications
INCLUDE_STATUSES=("disrupted" "down" "resolved")

# Exclude these statuses even if they appear in INCLUDE_STATUSES logic
EXCLUDE_STATUSES=("scheduled")

# Number of incidents returned by list command
LIST_LIMIT=20

# Notification mode:
# - stdout: print payloads to stdout
# - command: pipe payload JSON to OPENCLAW_NOTIFY_COMMAND
OPENCLAW_NOTIFY_MODE="stdout"

# Example command mode value:
# OPENCLAW_NOTIFY_COMMAND="openclaw notify"
OPENCLAW_NOTIFY_COMMAND=""

# Feed fetch timeout (seconds)
FETCH_TIMEOUT_SECONDS=20
